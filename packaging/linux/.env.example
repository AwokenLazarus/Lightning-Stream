# Lightning Stream on Linux: the settings docker-compose.yml reads. install.sh writes .env from your
# answers (mode 600: it holds the app's password and your node's RPC password). To edit by hand, copy
# this to .env, fill it in, then `docker compose up -d` in this folder.

# The Compose project: the containers are named after it.
COMPOSE_PROJECT_NAME=lightning-stream

# Where the app keeps its state: keys, spending rules, tickets. An absolute path.
LS_DATA_DIR=/home/you/lightning-stream/data

# The app's login password (the browser asks for it).
LS_UI_PASSWORD=

# Your Lightning node (lnd-family, such as Lightning Fork): its REST address and its TLS certificate.
LS_LND_REST=https://127.0.0.1:8080
LS_LND_TLS_CERT=/home/you/.lnd/tls.cert

# Your XBT node's RPC (Knots BLAKE2b). The wallet asks it about the chain; it never holds your coins.
LS_NODE_RPC_HOST=127.0.0.1
LS_NODE_RPC_PORT=8332
LS_NODE_RPC_USER=
LS_NODE_RPC_PASS=

# Hashtaker: where rented hashrate goes. "bundled" is the Stream Gateway (DATUM-compatible) that comes
# with the app: it masks its jobs, which renting needs (a hashmaker can't tell which shares would be
# blocks, so it can't keep those back). Its stratum is 127.0.0.1:23339 and its API 127.0.0.1:LS_DATUM_API_PORT,
# loopback only; solo or Lazarus Pool is set on Services → Hashrate. "own" is your own DATUM Gateway:
# LS_DATUM is its Stratum address and LS_GATEWAY_API its API, where every job is opened (/xbt/job) and
# checked to be masked before a miner gets it. A stock DATUM Gateway doesn't mask its jobs, so with one
# every rental is refused. LS_DATUM_OWN keeps your own gateway's address while the bundled one is used.
LS_DATUM_GATEWAY=bundled
LS_DATUM=127.0.0.1:23339
LS_GATEWAY_API=127.0.0.1:7153
LS_DATUM_OWN=
LS_DATUM_API_PORT=7153
# the Stream Gateway's stratum as the hashtaker knows it, or "off" with your own gateway (install.sh sets it)
LS_BUNDLED_GATEWAY=127.0.0.1:23339
# the user name the rented miners use on it
LS_DATUM_USER=rented

# Hashmaker: rent this machine's miners out. 1 turns it on (COMPOSE_PROFILES must then name it, and
# the two LS_UI_HASHMAKER* lines must be set; install.sh does all three). LS_LAN_HOST is this machine's
# LAN address, which your miners point at (port 23340).
LS_HASHMAKER=0
LS_LAN_HOST=
COMPOSE_PROFILES=
LS_UI_HASHMAKER=
LS_UI_HASHMAKER_SLICES=

# Ports, all on 127.0.0.1 (change one only if something else uses it).
LS_UI_PORT=8482
LS_MCP_PORT=33511
LS_CONNECTOR_PORT=8484
# sellers' own web pages, opened inside the app: one port each, on the same address as its page
LS_APP_PORTS=33521,33522,33523,33524
LS_GW_PORT=8402
LS_HASHTAKER_CONTROL_PORT=23343
# Links for your own player (VLC, mpv, a TV app) on another device, made on a Files page: by default
# they are on the UI's own address (127.0.0.1, so on this machine only). To open them, and nothing
# else of the app, to the LAN, uncomment both (each link is its own unguessable token, revocable, expiring):
#LS_LINKS_BIND=0.0.0.0:33541
#LS_LINKS_ADDRESS=http://<this machine's LAN address>:33541

# Nostr relays the app reads listings from and the hashmaker publishes to.
LS_RELAYS=wss://nostr.lazarus-xbt.xyz,wss://relay.lazarus-xbt.xyz,wss://relay.kilombino.com,wss://relay.damus.io,wss://nos.lol
